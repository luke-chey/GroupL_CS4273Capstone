# Flask-only Dockerfile (backend service)
FROM python:3.13.7

# Install minimal system deps for audio I/O if needed by the backend
RUN apt-get update && apt-get install -y \
    ca-certificates \
    ffmpeg \
    libsndfile1 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Install Python dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Set fixed nltk data directory
ENV NLTK_DATA=/usr/local/share/nltk_data
# Create directory
RUN mkdir -p /usr/local/share/nltk_data
# Download punkt into that directory at build time
RUN python -m nltk.downloader -d /usr/local/share/nltk_data punkt_tab

# Copy application code
COPY . .

ENV DOCKER_CONTAINER=true
ENV OLLAMA_HOST=http://ollama:11434/
ENV FLASK_ENV=production
ENV PORT=5001

EXPOSE 5001

# Run the Flask app directly
CMD ["python", "api/app.py"]
